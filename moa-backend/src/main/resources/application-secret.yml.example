# 이 파일을 application-secret.yml 로 복사한 뒤 실제 값을 입력하세요.
# application-secret.yml 은 .gitignore 에 포함되어 GitHub에 올라가지 않습니다.

spring:
  datasource:
    password: YOUR_MYSQL_PASSWORD

jwt:
  secret: YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG

google:
  client-id: YOUR_GOOGLE_OAUTH_CLIENT_ID
  client-secret: YOUR_GOOGLE_OAUTH_CLIENT_SECRET

kakao:
  rest-api-key: YOUR_KAKAO_REST_API_KEY
