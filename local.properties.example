# 이 파일을 local.properties 로 복사한 뒤 실제 값을 입력하세요.
# local.properties 는 .gitignore 에 포함되어 GitHub에 올라가지 않습니다.

sdk.dir=/path/to/Android/sdk

# Android OAuth (Web client ID — Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Kakao Native App Key
KAKAO_APP_KEY=your_kakao_native_app_key

# Backend server
# 에뮬레이터 (기본)
SERVER_URL=http://10.0.2.2:8080/
# 실기기 (같은 Wi-Fi): Mac IP — ipconfig getifaddr en0
# SERVER_URL=http://192.168.0.X:8080/
# 실기기 ADB: adb reverse tcp:8080 tcp:8080 후
# SERVER_URL=http://127.0.0.1:8080/

# 단기 일정 링크 공유용 공개 URL (카카오톡·문자 등 외부 공유 시 필수)
# 로컬 개발: ngrok http 8080 실행 후 아래에 ngrok URL 입력
# 배포: Railway/Render 등 배포 URL 입력
# 예: WEB_SHARE_URL=https://abc123.ngrok-free.app
#
# 카카오 Feed 템플릿 공유 시 필수 (developers.kakao.com):
# 1) 내 애플리케이션 > Moa > 제품 링크 > Web > 도메인에 WEB_SHARE_URL 호스트 등록
#    예: https://abc123.ngrok-free.app
# 2) 카카오톡 공유 ON
# 3) ngrok URL이 바뀌면 콘솔 도메인도 같이 수정
WEB_SHARE_URL=
